# InsightFlow server settings. TEMPLATE: copy to /etc/insightflow/insightflow.env on the server
# (owner root, group insightflow, mode 0640) and replace INSIGHTFLOW_HOSTNAME.
# The app needs no secrets. Never put passwords, tokens, or keys in this file or in the repository.
# Every setting is described in backend/.env.example and in deploy/README.md.

APP_ENV=production

# The site's host name, plus 127.0.0.1 for the checks run on the server itself (curl http://127.0.0.1:8000/...).
# Comma-separated, no scheme or port, no wildcards. The server refuses to start while the placeholder is here.
ALLOWED_HOSTS=INSIGHTFLOW_HOSTNAME,127.0.0.1

# The library: SQLite database and stored CSV files. A folder inside the mounted data volume, so a restore can
# move the old library aside (a mount point itself cannot be renamed).
DATA_DIR=/var/lib/insightflow/library

# Keep nginx's client_max_body_size about 1 MB above this (deploy/nginx/insightflow-https.conf).
MAX_UPLOAD_MB=10

# Per analysis. The page runs about five analyses at once, so the worst case is roughly five times the memory
# limit plus the parsed files; the systemd unit caps the whole service (MemoryMax).
DUCKDB_THREADS=2
DUCKDB_MEMORY_LIMIT=1GB

# The optional local AI summary stays off on the server.
INSIGHTS_NARRATOR=none
