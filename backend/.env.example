# Copy this file to `.env` and edit the values for your machine.
# `.env` is ignored by Git. Never commit real secrets.

# Shown in the health check. Use: development, test, or production.
APP_ENV=development

# Largest CSV upload accepted, in megabytes.
MAX_UPLOAD_MB=10

# Where saved datasets are kept: uploaded files in <DATA_DIR>/uploads/ and the SQLite
# database <DATA_DIR>/insightflow.db. Relative paths are relative to backend/.
# If this project is inside OneDrive, a folder outside it avoids sync conflicts,
# for example: DATA_DIR=C:/InsightFlowData
DATA_DIR=data

# Optional AI summaries of the key findings. Off by default: the findings never need them.
# "ollama" uses a free model running on this computer. Install Ollama (https://ollama.com),
# run `ollama pull llama3.2:3b`, set INSIGHTS_NARRATOR=ollama, and restart the backend.
INSIGHTS_NARRATOR=none
# Must point to Ollama on this computer (localhost). Any other address is refused, so the
# findings sent for a summary never leave this machine.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
# Seconds to wait for a summary. On a laptop CPU a short summary can take a minute.
OLLAMA_TIMEOUT_SECONDS=120

# Reserved for a possible later Gemini narrator. Not used yet; leave blank.
# This key stays on the backend. It must never be added to the frontend.
GEMINI_API_KEY=
