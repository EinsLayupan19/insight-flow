# Copy this file to `.env` and edit the values for your machine.
# `.env` is ignored by Git. Never commit real secrets.

# Shown in the health check. Use: development, test, or production.
APP_ENV=development

# Largest CSV upload accepted, in megabytes.
MAX_UPLOAD_MB=10

# Used in a later phase (AI questions). Leave blank for now.
# This key stays on the backend. It must never be added to the frontend.
GEMINI_API_KEY=
